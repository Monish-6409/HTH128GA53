# ResQAI Environment Configuration

# Backend API Port
PORT=8000
BACKEND_URL=http://localhost:8000

# AI Models (Optional - system operates with deterministic simulation engine when unconfigured)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase / PostgreSQL Database (Optional - runs in-memory mock engine if unset)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Simulation Speed & Operational Limits
SIMULATION_TICK_SECONDS=10
DEFAULT_MAP_LAT=13.0827
DEFAULT_MAP_LNG=80.2707
